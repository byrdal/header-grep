  "license": "MIT",
  "bugs": {
    "url": "https://github.com/byrdal/header-grep/issues"
  },
  "homepage": "https://github.com/byrdal/header-grep#readme",
  "dependencies": {
    "@preact/signals": "^2.11.3",
    "preact": "^11.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/chrome": "^0.3.4",
    "@types/har-format": "^1.2.16",
    "eslint": "^10.0.0",
    "globals": "^17.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
