{
  "name": "header-grep",
  "private": true,
  "description": "Chrome extension, grep header names and values",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "watch": "vite build --watch",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/byrdal/header-grep.git"
  },
